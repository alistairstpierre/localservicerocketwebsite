---
// Results / case studies: verified client outcomes from master copy doc. Same Ignition layout as homepage (no fictional dossiers).
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SKOOL_URL } from "../data/site";
import { buildInnerPageJsonLd } from "../lib/jsonLd";

const dryDuckImg = "/dry-duck-truck.webp";

const coastalImg = "/coastal-current-truck.webp";

const clients = [
  {
    tag: "Rewired Iowa — Electrician, Iowa · since 2023",
    headline: "$60k/mo → $250k/mo average · $300k peak Dec 2025",
    body: "+316% revenue growth. Six failed agencies before this stack. SEO and Google Ads under one AI-assisted system.",
    stat: "+316%",
    statLabel: "Revenue growth",
  },
  {
    tag: "Hooked Up Electric — Texas · since 2024",
    headline: "50–80 booked jobs/month from Google Ads and Google Guaranteed",
    body: "Expanded from one location to four in under two years — led by performance campaigns, not billboards.",
    stat: "1→4",
    statLabel: "Locations",
  },
  {
    tag: "Motha Electric — Melbourne AU · since 2024",
    headline: "$700k revenue reported for 2025",
    body: "Zero residential calls before launch. Three calls per day within weeks once the system was live.",
    stat: "$700k",
    statLabel: "2025 revenue report",
  },
  {
    tag: "AZ DC Electric — Phoenix AZ · since 2025",
    headline: "5–8 residential calls/week within weeks",
    body: "Google Ads produced zero leads with the previous vendor. GBP and website corrected in 14 days; then campaigns had something real to lean on.",
    stat: "5–8/wk",
    statLabel: "Calls (early)",
  },
  {
    tag: "Austral Energy Solutions — Electrician & Solar, AU · 2025",
    headline: "Record revenue month inside 30 days",
    body: "Fully booked in under three months. Enough demand to justify new hires — marketing plus their ops keeping promises.",
    stat: "30d",
    statLabel: "To record month",
  },
];

const title = "Client Results & Case Studies | Local Service Rocket";
const description =
  "Real electricians and trade businesses: revenue growth, locations added, calls per week, and AI-built sites ranking in market. NZ, AU, USA.";
const jsonLd = buildInnerPageJsonLd({
  pathname: Astro.url.pathname,
  pageType: "WebPage",
  title,
  description,
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} pageSparks={true} ogImagePath={dryDuckImg}>
  <SiteHeader slot="header" />

  <main class="relative z-10 pb-20 pt-8">
    <header class="relative mx-auto max-w-7xl px-6 py-12 md:px-8 md:py-16">
      <div class="pointer-events-none absolute inset-0 opacity-30">
        <div class="grid-overlay"></div>
      </div>
      <div class="relative max-w-4xl">
        <span class="mb-4 inline-block text-[10px] font-black uppercase tracking-[0.35em] text-primary-container">
          Results
        </span>
        <h1 class="mb-6 font-headline text-4xl font-black uppercase leading-[0.95] tracking-tighter text-white md:text-6xl lg:text-7xl">
          Real Businesses.
          <span class="flame-headline">Real Numbers.</span>
        </h1>
        <p
          class="max-w-2xl border-l-4 border-primary-container bg-white/[0.03] py-3 pl-6 text-lg text-neutral-400"
        >
          Every story here ties back to the same AI-led playbook we teach. Outcomes depend on you, too —
          reviews, service, and sales have to keep pace with the leads.
        </p>
      </div>
    </header>

    <section class="relative overflow-hidden border-y border-primary-container/20 bg-surface-container-lowest py-12 md:py-16">
      <div class="exhaust-smoke absolute inset-0"></div>
      <div class="relative z-10 mx-auto grid max-w-7xl gap-8 px-6 sm:grid-cols-2 md:grid-cols-4 md:px-8">
        <div class="flex flex-col">
          <span class="font-headline text-4xl font-black text-secondary-container afterburner-glow md:text-5xl">$250k</span>
          <span class="mt-2 text-[10px] font-black uppercase tracking-widest text-neutral-500"
            >Peak monthly revenue (Iowa client)</span
          >
        </div>
        <div class="flex flex-col">
          <span class="telemetry-value font-headline text-4xl font-black md:text-5xl">+316%</span>
          <span class="mt-2 text-[10px] font-black uppercase tracking-widest text-neutral-500"
            >Revenue growth (same account)</span
          >
        </div>
        <div class="flex flex-col">
          <span class="font-headline text-4xl font-black text-white afterburner-glow md:text-5xl">30d</span>
          <span class="mt-2 text-[10px] font-black uppercase tracking-widest text-neutral-500"
            >Top 3 local proof (Dry Duck)</span
          >
        </div>
        <div class="flex flex-col">
          <span class="font-headline text-4xl font-black text-primary md:text-5xl">10</span>
          <span class="mt-2 text-[10px] font-black uppercase tracking-widest text-neutral-500"
            >SMEs active now · US · AU · NZ</span
          >
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl space-y-16 px-6 py-16 md:space-y-20 md:px-8 md:py-24">
      <!-- Featured: Dry Duck + Coastal -->
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <article class="mission-panel brutal-border flex flex-col overflow-hidden border-l-4 border-l-primary-container">
          <div class="relative h-56 shrink-0 md:h-64">
            <img
              class="h-full w-full object-cover opacity-90"
              alt="Dry Duck Basements — basement waterproofing Des Moines Iowa website and local SEO"
              src={dryDuckImg}
              width="1200"
              height="412"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="text-[10px] font-black uppercase tracking-widest text-secondary-container"
                >Website + AI SEO — Des Moines, Iowa</span
              >
            </div>
          </div>
          <div class="flex flex-grow flex-col p-8">
            <h2 class="mb-4 font-headline text-2xl font-black uppercase leading-tight tracking-tighter text-white md:text-3xl">
              Top 3 in a 10-mile radius — within
              <span class="text-secondary-container">30 days</span> of launch
            </h2>
            <p class="mb-6 flex-grow text-sm leading-relaxed text-neutral-400">
              Live site and SEO built with AI. Top 3 for local waterproofing searches within a month.
              Real homeowner enquiries — the proof we point to when someone asks if the system still
              works in the wild.
            </p>
            <a
              href="https://dryduckbasements.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-headline text-sm font-bold uppercase tracking-widest text-primary hover:text-white"
            >
              dryduckbasements.com
              <span class="material-symbols-outlined text-base icon-outline">arrow_outward</span>
            </a>
          </div>
        </article>

        <article class="mission-panel brutal-border flex flex-col overflow-hidden border-l-4 border-l-white/20">
          <div class="relative h-56 shrink-0 md:h-64">
            <img
              class="h-full w-full object-cover opacity-90"
              alt="Coastal Current Electrician — branded service truck, South Orange County CA"
              src={coastalImg}
              width="1024"
              height="375"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
              <span class="text-[10px] font-black uppercase tracking-widest text-neutral-400"
                >Portfolio — South Orange County, CA · not yet live for rankings claims</span
              >
            </div>
          </div>
          <div class="flex flex-grow flex-col p-8">
            <h2 class="mb-4 font-headline text-2xl font-black uppercase leading-tight tracking-tighter text-white md:text-3xl">
              Full electrician site — built with AI, structured for local SEO from day one
            </h2>
            <p class="mb-6 flex-grow text-sm leading-relaxed text-neutral-400">
              Service pages, location pages, and technical setup ready for launch. We don't claim ranking
              results here until the site is live and the data says so — use this row as quality and
              process proof only.
            </p>
            <a
              href="https://coastal-current-website.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-headline text-sm font-bold uppercase tracking-widest text-primary hover:text-white"
            >
              Preview build
              <span class="material-symbols-outlined text-base icon-outline">arrow_outward</span>
            </a>
          </div>
        </article>
      </div>

      <!-- Client cards -->
      <div>
        <h2 class="mb-8 font-headline text-2xl font-black uppercase tracking-tighter text-white md:text-3xl">
          Campaign &amp; Growth <span class="flame-headline">Snapshots</span>
        </h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            clients.map((c) => (
              <article class="border-t-2 border-primary-container/40 bg-surface-container p-6 transition-colors hover:border-primary-container hover:bg-surface-bright">
                <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-neutral-500">{c.tag}</p>
                <h3 class="mb-3 font-headline text-lg font-bold leading-snug text-white">{c.headline}</h3>
                <p class="mb-4 text-sm leading-relaxed text-neutral-400">{c.body}</p>
                <div class="flex items-end justify-between border-t border-white/10 pt-4">
                  <span class="font-headline text-2xl font-black text-secondary-container afterburner-glow">
                    {c.stat}
                  </span>
                  <span class="max-w-[10rem] text-right text-[10px] font-black uppercase tracking-widest text-neutral-500">
                    {c.statLabel}
                  </span>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="mission-panel brutal-border border-l-4 border-secondary-container bg-surface-container-lowest px-6 py-10 md:px-10">
        <p class="text-sm leading-relaxed text-neutral-400">
          These aren't lottery tickets. They're owners who answered the phone, chased reviews, and kept
          promises once we sent the traffic. If you want the same trajectory, plan to show up on your
          side of the hand-off too.
        </p>
      </div>

      <div class="flex flex-col items-center justify-center gap-4 border border-white/10 bg-black/40 px-6 py-14 text-center md:flex-row md:gap-8">
        <a
          href="/contact"
          class="afterburner-btn inline-flex items-center justify-center bg-primary-container px-10 py-5 font-headline text-sm font-black uppercase tracking-widest text-white md:px-12"
        >
          Book a Free Strategy Call
        </a>
        <a
          href="/services"
          class="inline-flex items-center justify-center border-2 border-white/20 px-10 py-5 font-headline text-sm font-black uppercase tracking-widest text-white hover:bg-white hover:text-black"
        >
          AI Services &amp; Pricing
        </a>
        <a
          href={SKOOL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-headline text-sm font-black uppercase tracking-widest text-secondary-container underline decoration-secondary-container underline-offset-4 hover:text-white"
        >
          Learn to Do It Yourself — Free
        </a>
      </div>
    </section>
  </main>

  <SiteFooter slot="footer" />
</BaseLayout>
