---
// Homepage: StoryBrand structure from LSR Master Copy Document v1.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HomeContent from "../components/home/HomeContent.astro";
import { buildHomepageJsonLd } from "../lib/jsonLd";

const title = "AI Marketing Systems for Local Businesses | Local Service Rocket";
const description =
  "We build websites, run SEO, and manage ads using AI — getting local businesses to the top of Google faster and cheaper than a traditional agency. See results. Book a free call.";
const jsonLd = buildHomepageJsonLd(title, description);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} mainClass="pt-0">
  <SiteHeader slot="header" />
  <HomeContent />
  <SiteFooter slot="footer" />
</BaseLayout>
