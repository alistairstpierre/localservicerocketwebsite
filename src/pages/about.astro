---
// About: founder story, philosophy, markets, aligned with master copy doc (no fictional team).
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SKOOL_URL } from "../data/site";
import { buildInnerPageJsonLd } from "../lib/jsonLd";

const founderPhoto = "/alistair-profile.webp";

const title = "About Local Service Rocket | Founder, Story & How We Work";
const description =
  "Founded after helping a local electrician get more calls. Built on real clients across NZ, AU, and USA. Google Partner. Whatever it takes, move fast, fix fast.";
const jsonLd = buildInnerPageJsonLd({
  pathname: Astro.url.pathname,
  pageType: "AboutPage",
  title,
  description,
  primaryImagePath: founderPhoto,
});

const pillars = [
  {
    icon: "handshake",
    title: "Hand-in-hand",
    body: "Marketing is one side of the scoreboard. Reviews, callbacks, and how you close matter just as much. We work with owners who get that.",
  },
  {
    icon: "speed",
    title: "Ship, then improve",
    body: "The AI-led stack we use now beats the old agency rhythm: long decks, slow tickets, vague reporting. We iterate from live search and ad data.",
  },
  {
    icon: "account_balance",
    title: "Plain numbers",
    body: "You'll see what we're doing and why. No fluff adjectives: specific clients, timeframes, and outcomes where we can show them.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} ogImagePath={founderPhoto}>
  <SiteHeader slot="header" />

  <section class="relative overflow-hidden px-6 pb-16 pt-8 md:px-8 md:pb-24">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary-container/5 to-transparent"></div>
    <div class="relative z-10 mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <span class="mb-4 inline-block text-[10px] font-black uppercase tracking-[0.35em] text-secondary-container">
          About
        </span>
        <h1 class="mb-6 font-headline text-4xl font-black uppercase leading-[0.95] tracking-tighter text-white md:text-5xl lg:text-6xl">
          Local Service Rocket Exists Because
          <span class="flame-headline">Local Owners Were Getting Burned</span>
        </h1>
        <p class="mb-6 max-w-2xl text-lg text-neutral-400">
          It started with one electrician who needed more calls. Agencies had taken the money and
          left him thin. We built a system that actually moved the needle, then proved it again in
          other trades and cities.
        </p>
        <p class="max-w-2xl text-neutral-400">
          Today we're a certified Google Partner, active with <span class="font-bold text-secondary-container">10 SMEs</span> across the United States, Australia, and New Zealand, and we're still learning in the field every week.
        </p>
      </div>
      <div class="lg:col-span-5">
        <div class="brutal-border relative overflow-hidden border-2 border-white/10">
          <img
            alt="Alistair St Pierre, founder of Local Service Rocket"
            class="w-full object-cover grayscale contrast-110"
            src={founderPhoto}
            width="750"
            height="1000"
            loading="eager"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-black/75 px-4 py-3 backdrop-blur-sm">
            <p class="font-headline text-sm font-bold text-white">Alistair St Pierre</p>
            <p class="text-xs text-neutral-400">Founder, Local Service Rocket</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface-container-lowest px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-4 font-headline text-2xl font-black uppercase tracking-tighter text-white md:text-3xl">
          Who's Behind This
        </h2>
        <p class="mb-4 text-neutral-400">
          <span class="font-headline font-bold text-white">Alistair St Pierre</span>, 12+ years in tech,
          international StarCraft II competitor, deep AI practitioner, and someone who built and worked on
          websites before the agency existed.
        </p>
        <p class="text-neutral-400">
          He's not pitching theory from a stage. He's in the accounts. The same AI-led playbook we teach on
          Skool is the one we run for clients.
        </p>
      </div>
      <div class="mission-panel brutal-border panel-texture p-8 md:p-10">
        <h3 class="mb-3 font-headline text-xs font-black uppercase tracking-[0.35em] text-primary-container">
          Philosophy
        </h3>
        <p class="font-headline text-xl font-bold text-white">"Whatever it takes."</p>
        <p class="mt-4 text-sm leading-relaxed text-neutral-400">
          Move fast. Fix fast. Tell the truth when something isn't working. We'd rather lose a pitch than
          promise magic you can't hold us to.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-12 text-center font-headline text-3xl font-black uppercase tracking-tighter text-white md:text-4xl">
        How We <span class="flame-headline">Work With You</span>
      </h2>
      <div class="grid grid-cols-1 gap-px md:grid-cols-3 md:bg-white/5">
        {
          pillars.map((p, i) => (
            <div
              class:list={[
                "p-10 transition-colors hover:bg-surface-bright",
                i === 1 ? "bg-surface-container-high" : "bg-surface-container",
              ]}
            >
              <span class="material-symbols-outlined mb-6 block text-4xl text-primary icon-outline">
                {p.icon}
              </span>
              <h3 class="mb-3 font-headline text-lg font-bold uppercase tracking-tight text-white">
                {p.title}
              </h3>
              <p class="text-sm leading-relaxed text-neutral-400">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-white/5 bg-surface-container-lowest px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 font-headline text-2xl font-black uppercase text-white md:text-3xl">
        Two Ways to Work With Us
      </h2>
      <p class="mb-8 text-neutral-400">
        Done-for-you marketing with a flat fee and full ownership of what we build, or learn the same
        stack yourself, free, in the Skool community.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="afterburner-btn inline-flex justify-center bg-primary-container px-8 py-4 font-headline text-sm font-black uppercase text-white"
        >
          Book a Free Strategy Call
        </a>
        <a
          href={SKOOL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex justify-center border-2 border-white/20 px-8 py-4 font-headline text-sm font-black uppercase text-white hover:bg-white hover:text-black"
        >
          Learn to Do It Yourself, Free
        </a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
