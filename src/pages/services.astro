---
// AI Services: pricing + shared four-phase process; per-service breakdown (custom via AI, not templates).
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SKOOL_URL } from "../data/site";

const placeholderWide =
  "https://placehold.co/1200x720/0f0f0f/ff571a/png?text=AI+marketing+workspace&font=roboto";

/** Per-service phase rows use the same icons as the global process for visual consistency. */
const phaseRowDefs = [
  { key: "strategy", label: "Strategy", icon: "map" },
  { key: "research", label: "Research", icon: "manage_search" },
  { key: "setup", label: "Setup", icon: "construction" },
  { key: "management", label: "Management", icon: "autorenew" },
] as const;

const processPhases = [
  {
    step: "01",
    name: "Strategy",
    icon: "map",
    summary: "What we're trying to win, for your business — not a generic playbook.",
  },
  {
    step: "02",
    name: "Research",
    icon: "manage_search",
    summary: "Your market, search demand, competitors, and gaps — fed into every decision.",
  },
  {
    step: "03",
    name: "Setup",
    icon: "construction",
    summary: "Foundations: tech, tracking, structures, and brand or account architecture — built right once.",
  },
  {
    step: "04",
    name: "Management",
    icon: "autorenew",
    summary:
      "Keep what's live healthy: monitor, fix drift, and tune from real signals — so nothing quietly breaks or stalls.",
  },
];

const serviceOffers = [
  {
    id: "website",
    name: "Website & branding build",
    price: "[Price TBD]",
    period: "one-off",
    icon: "web",
    tagline:
      "SEO-ready site you own outright — plus branding that matches how you actually show up in the market.",
    intro:
      "This isn't a theme with your logo dropped in. We use expert AI workflows to shape messaging, structure, and visuals around your trade and your service area. Branding work (voice, visual direction, on-page story) is part of the website engagement — so the site feels like you, not like every other contractor template.",
    steps: {
      strategy:
        "Clarify offer, service area, proof, and what a lead should do next. Lock voice, visual direction, and conversion story — headlines, trust blocks, CTAs — for your business.",
      research:
        "Map local search demand, competitor pages, and the URL set you actually need. Decide service vs location pages from real SERP patterns in your market.",
      setup:
        "Design system (type, colour, layout patterns), wireframe logic, schema, and performance baseline. Build on a clean technical stack — AI accelerates production; humans set the bar.",
      management:
        "Go-live QA: forms, speed, and tracking verified in production. Hand off repo, hosting, and brand kit — you own it — with everything running smoothly before we close. Optional ongoing care if you want us to stay close.",
    },
  },
  {
    id: "seo",
    name: "SEO & local visibility",
    price: "$400",
    period: "/month",
    setupFeeNote:
      "Plus a one-time setup fee — scoped to your site, GBP, and competitive set. We quote it after the strategy pass once we know what's actually required.",
    icon: "trending_up",
    tagline: "On-page, local, and Google Maps signals — managed with AI, tuned to your URLs and city.",
    intro:
      "You get the same four phases as every other client — but the keyword map, content priorities, and GBP work are built for your properties only. We don't run a one-size spreadsheet and call it strategy.",
    steps: {
      strategy:
        "Prioritise organic vs Maps, set realistic targets with you, and align SEO work with the leads you actually want (emergency vs quoted, residential vs commercial, etc.).",
      research:
        "Audit existing pages, entities, citations, and competitors in your pack. Pull gap lists: content, internal links, GBP categories, reviews velocity — specific to your site.",
      setup:
        "Technical checklist, content briefs, internal linking map, GBP posting calendar, and measurement (Search Console, rank context, call tracking where it fits).",
      management:
        "Month to month: keep the programme running — publish fixes, watch Search Console and Maps, adjust content and GBP from what your data shows. Catch technical creep and ranking drift before it costs you enquiries.",
    },
  },
  {
    id: "ads",
    name: "Advertising",
    price: "$400",
    period: "/month",
    setupFeeNote:
      "Plus a one-time setup fee — depends on platforms, tracking complexity, and whether we're cleaning up an existing account vs starting fresh. Quoted after strategy.",
    icon: "campaign",
    tagline: "Google and Meta structured for enquiries — AI assists targeting, creative cycles, and iteration.",
    intro:
      "Campaign architecture, naming, and audiences are custom to your offer and geography. AI speeds research and creative variation; we still anchor spend and messaging to your margins and your sales capacity.",
    steps: {
      strategy:
        "Define offer, radius, budget guardrails, and which platforms earn a seat (Search, LSA, Meta, etc.) — matched to your economics and lead volume goals.",
      research:
        "Review competitor angles, search themes, audience signals, and historic account data if we're inheriting a messy account — know what failed before we spend.",
      setup:
        "Clean conversion tracking, campaign structure, audience seeds, ad group / asset grouping, and naming you can read six months later.",
      management:
        "Keep accounts stable and honest: monitor spend, search terms, and lead quality; refresh creative and negatives on a rhythm; reset budgets and bids before waste piles up — optimise to cost per qualified lead, not vanity clicks.",
    },
  },
];
---

<BaseLayout
  title="AI Marketing Services — Websites, SEO & Ads | Local Service Rocket"
  description="Custom websites with branding, local SEO, and AI-assisted ads. Monthly retainers plus scoped one-time setup for SEO and ads. Same four-phase process for every client."
>
  <SiteHeader slot="header" />
  <header class="relative overflow-hidden px-6 pb-16 pt-8 md:px-8 md:pb-20">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative z-10 max-w-3xl">
        <span
          class="mb-4 inline-block border border-primary-container px-4 py-1 font-headline text-[10px] font-black uppercase tracking-[0.35em] text-primary-container"
        >
          AI Services
        </span>
        <h1 class="mb-6 font-headline text-4xl font-black uppercase leading-[0.95] tracking-tighter text-white md:text-5xl lg:text-6xl">
          AI Marketing Services That Run for
          <span class="flame-headline">Local Businesses</span>
        </h1>
        <p class="mb-4 text-lg text-neutral-400">
          Every company goes through the same expert process: <span class="font-headline font-bold text-white"
            >Strategy → Research → Setup → Management</span
          >. AI makes us fast and consistent — it does <span class="italic text-secondary-container">not</span> mean
          cookie-cutter templates. Each deliverable is custom-built for your market, your offer, and your brand.
        </p>
        <p class="mb-8 text-sm text-neutral-500">
          Ongoing SEO and ads are a flat monthly fee, with a <span class="text-neutral-400">one-time setup</span> scoped
          and quoted per client. No lock-in. You own what we build. Same stack we run with 10 SMEs across the US,
          Australia, and New Zealand.
        </p>
        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="/contact"
            class="afterburner-btn inline-flex items-center justify-center bg-primary-container px-8 py-4 font-headline text-sm font-black uppercase tracking-tight text-white"
          >
            Book a Free Strategy Call
          </a>
          <a
            href={SKOOL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center border-2 border-white/20 px-8 py-4 font-headline text-sm font-black uppercase tracking-tight text-white hover:bg-white hover:text-black"
          >
            Learn to Do It Yourself — Free
          </a>
        </div>
      </div>
      <div
        class="relative aspect-[4/3] overflow-hidden border-2 border-white/10 brutal-border lg:aspect-auto lg:min-h-[320px]"
      >
        <img
          alt="Placeholder — AI marketing and local business growth workspace"
          class="h-full w-full object-cover opacity-90"
          src={placeholderWide}
          width="1200"
          height="720"
          loading="eager"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-deep/80 to-transparent"></div>
      </div>
    </div>
    <div class="pointer-events-none absolute -right-20 top-10 h-[480px] w-1/2 max-w-xl rounded-full bg-primary-container/15 blur-[100px]">
    </div>
  </header>

  <main class="border-t border-white/5 bg-surface-container-lowest px-6 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div
        class="mission-panel brutal-border mb-16 grid grid-cols-1 gap-8 border-l-4 border-l-primary-container/50 p-8 md:grid-cols-2 md:p-10"
      >
        <div>
          <h2 class="mb-3 font-headline text-xs font-black uppercase tracking-[0.35em] text-neutral-500">
            Old agency pattern
          </h2>
          <p class="text-sm leading-relaxed text-neutral-400">
            Retainers you can't decode, slow handoffs, and a wall between you and the work — often the same template
            resold with a new logo.
          </p>
        </div>
        <div>
          <h2 class="mb-3 font-headline text-xs font-black uppercase tracking-[0.35em] text-primary-container">
            Our AI-led process
          </h2>
          <p class="text-sm leading-relaxed text-neutral-300">
            One repeatable loop — Strategy through Management — that produces <strong class="text-white"
              >custom</strong
            > assets every time. Expert judgement at the gates; AI for speed, research depth, and iteration quality.
          </p>
        </div>
      </div>

      <!-- Jump links: read top → bottom or skip to a service -->
      <nav
        class="mb-14 scroll-mt-28 border-y border-white/10 bg-black/20 py-5"
        aria-label="On this page"
      >
        <p class="mb-3 font-headline text-[10px] font-black uppercase tracking-[0.3em] text-neutral-600">
          Jump to
        </p>
        <div class="flex flex-wrap gap-2">
          <a
            href="#our-process"
            class="border border-white/15 bg-white/[0.03] px-3 py-2 font-headline text-[10px] font-black uppercase tracking-widest text-neutral-300 transition-colors hover:border-primary-container hover:text-white"
          >
            The process
          </a>
          {
            serviceOffers.map((svc) => (
              <a
                href={`#${svc.id}`}
                class="border border-white/15 bg-white/[0.03] px-3 py-2 font-headline text-[10px] font-black uppercase tracking-widest text-neutral-300 transition-colors hover:border-primary-container hover:text-white"
              >
                {svc.name}
              </a>
            ))
          }
          <a
            href="#bundle"
            class="border border-white/15 bg-white/[0.03] px-3 py-2 font-headline text-[10px] font-black uppercase tracking-widest text-neutral-300 transition-colors hover:border-primary-container hover:text-white"
          >
            Bundle
          </a>
        </div>
      </nav>

      <!-- Global process: vertical timeline (read as a single flow) -->
      <section class="mb-20 md:mb-28 scroll-mt-28" id="our-process" aria-labelledby="our-process-heading">
        <h2
          id="our-process-heading"
          class="mb-3 font-headline text-3xl font-black uppercase tracking-tighter text-white md:text-4xl"
        >
          The Same Four Phases for <span class="flame-headline">Every Engagement</span>
        </h2>
        <p class="mb-10 max-w-2xl text-neutral-400">
          Read this once top to bottom — it's the spine. Every service below walks the same stripes; only the work
          inside each phase changes.
        </p>
        <div class="relative max-w-3xl border-l-2 border-primary-container/35 pl-8 md:pl-10">
          {
            processPhases.map((p, i) => (
              <div class:list={["relative", i < processPhases.length - 1 ? "pb-12 md:pb-14" : "pb-2"]}>
                <div
                  class="absolute -left-[25px] top-1 flex h-6 w-6 items-center justify-center rounded-full border-2 border-primary-container bg-surface-container-lowest md:-left-[29px]"
                  aria-hidden="true"
                >
                  <span class="h-2 w-2 rounded-full bg-primary-container" />
                </div>
                <div class="mb-2 flex flex-wrap items-center gap-3">
                  <span class="material-symbols-outlined text-2xl text-primary-container">{p.icon}</span>
                  <span class="font-headline text-[10px] font-black text-secondary-container">{p.step}</span>
                  <h3 class="font-headline text-lg font-bold uppercase tracking-tight text-white">{p.name}</h3>
                </div>
                <p class="text-sm leading-relaxed text-neutral-400">{p.summary}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Per-service: header band + matching vertical timeline -->
      <div class="border-t-2 border-white/10 pt-14 md:pt-16">
        <h2 class="mb-3 font-headline text-3xl font-black uppercase tracking-tighter text-white md:text-4xl">
          How the Process <span class="flame-headline">Maps to Each Service</span>
        </h2>
        <p class="mb-12 max-w-2xl text-neutral-400">
          Same four steps in order. Pricing sits in each header; scroll the timeline for what we actually do in that
          phase for you.
        </p>

        <div class="space-y-20 md:space-y-24">
          {
            serviceOffers.map((svc) => (
              <article
                class="scroll-mt-28 overflow-hidden border-2 border-white/10 brutal-border mission-panel"
                id={svc.id}
              >
                <div class="border-b border-white/10 bg-surface-container/60 px-6 py-8 md:px-10 md:py-9 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start lg:gap-10">
                  <div class="mb-8 flex gap-4 lg:mb-0">
                    <span class="material-symbols-outlined shrink-0 text-4xl text-primary-container icon-outline">
                      {svc.icon}
                    </span>
                    <div class="min-w-0">
                      <h3 class="font-headline text-2xl font-black uppercase tracking-tight text-white md:text-3xl">
                        {svc.name}
                      </h3>
                      <p class="mt-2 text-sm leading-relaxed text-neutral-400">{svc.tagline}</p>
                      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-neutral-300 lg:text-base">{svc.intro}</p>
                    </div>
                  </div>
                  <div class="flex flex-col border-t border-white/10 pt-6 lg:border-0 lg:border-l lg:border-white/10 lg:pt-0 lg:pl-10">
                    <p class="font-headline text-[10px] font-black uppercase tracking-[0.25em] text-neutral-600">
                      Pricing
                    </p>
                    <p class="mt-2 font-headline text-2xl font-bold text-secondary-container lg:text-3xl">
                      {svc.price}
                      <span class="text-sm font-normal text-neutral-500">{svc.period}</span>
                    </p>
                    {"setupFeeNote" in svc && svc.setupFeeNote ? (
                      <p class="mt-3 text-xs leading-snug text-neutral-500">{svc.setupFeeNote}</p>
                    ) : null}
                    <a
                      href="/contact"
                      class="mt-6 inline-flex w-full items-center justify-center border border-outline-variant py-3.5 font-headline text-xs font-black uppercase tracking-widest text-white transition-colors hover:bg-primary-container hover:text-white"
                    >
                      Get Started
                    </a>
                  </div>
                </div>
                <div class="panel-texture px-6 py-9 md:px-10 md:py-11">
                  <p class="mb-8 font-headline text-[10px] font-black uppercase tracking-[0.3em] text-secondary-container">
                    The four phases — in order
                  </p>
                  <div class="relative max-w-3xl border-l-2 border-secondary-container/30 pl-8 md:pl-10">
                    {phaseRowDefs.map((def, i) => (
                      <div class:list={["relative", i < phaseRowDefs.length - 1 ? "pb-10 md:pb-12" : "pb-2"]}>
                        <div
                          class="absolute -left-[25px] top-0.5 flex h-6 w-6 items-center justify-center rounded-full border-2 border-secondary-container/60 bg-surface-container-lowest md:-left-[29px]"
                          aria-hidden="true"
                        >
                          <span class="material-symbols-outlined text-sm text-secondary-container">{def.icon}</span>
                        </div>
                        <div class="mb-1.5 flex flex-wrap items-baseline gap-2">
                          <span class="font-headline text-[10px] font-black text-neutral-600">
                            {String(i + 1).padStart(2, "0")}
                          </span>
                          <h4 class="font-headline text-sm font-black uppercase tracking-widest text-white">
                            {def.label}
                          </h4>
                        </div>
                        <p class="text-sm leading-relaxed text-neutral-400">
                          {svc.steps[def.key as keyof typeof svc.steps]}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="mt-16 scroll-mt-28 border-l-4 border-secondary-container bg-surface-container p-8 md:p-10" id="bundle">
        <p class="font-headline text-sm font-black uppercase tracking-[0.2em] text-secondary-container">
          SEO + Advertising together
        </p>
        <p class="mt-2 text-lg font-headline font-bold text-white">$800 / month combined</p>
        <p class="mt-2 max-w-2xl text-sm text-neutral-400">
          One engagement, one process — both channels planned under the same strategy and research pass so Search,
          Maps, and paid don't fight each other.
        </p>
        <p class="mt-3 max-w-2xl text-xs leading-relaxed text-neutral-500">
          SEO and advertising each carry a <span class="text-neutral-400">one-time setup fee</span> based on what you
          need; we quote setup after strategy (sometimes one consolidated setup makes sense for both).
        </p>
      </div>

      <div class="mt-16 border-t border-white/10 pt-12 text-center">
        <h3 class="mb-3 font-headline text-xl font-bold uppercase text-white">
          Not ready to hand it over? Learn to build it yourself — free.
        </h3>
        <p class="mx-auto mb-6 max-w-2xl text-sm text-neutral-400">
          We teach the same Strategy → Research → Setup → Management thinking on Skool — websites, SEO, Google
          Business Profile, and ads.
        </p>
        <a
          href={SKOOL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/20 px-8 py-4 font-headline text-sm font-black uppercase tracking-tight text-white hover:bg-white hover:text-black"
        >
          Learn to Do It Yourself
          <span class="material-symbols-outlined text-base icon-outline">arrow_outward</span>
        </a>
      </div>
    </div>
  </main>

  <section class="relative overflow-hidden bg-surface py-20 md:py-28">
    <div class="grid-overlay pointer-events-none absolute inset-0 opacity-20"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center md:px-8">
      <h2 class="mb-6 font-headline text-3xl font-black uppercase tracking-tighter text-white md:text-4xl">
        Ready to Talk It Through?
      </h2>
      <p class="mb-8 text-neutral-400">
        Book a free 30-minute strategy call. We'll walk which service fits first — and how the four phases would
        look for your business.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="afterburner-btn inline-flex justify-center bg-primary-container px-10 py-5 font-headline text-sm font-black uppercase tracking-tight text-white"
        >
          Book a Free Strategy Call
        </a>
        <a
          href="/case-studies"
          class="inline-flex justify-center border-2 border-white/20 px-10 py-5 font-headline text-sm font-black uppercase tracking-tight text-white hover:bg-white/10"
        >
          See Results
        </a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
